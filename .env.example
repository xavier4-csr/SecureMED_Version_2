# Local development only: generate a strong random value and keep it in .env.
SECRET_KEY=replace-with-a-generated-random-secret

# Optional: the current synthetic demo does not use a database.
# For local PostgreSQL development, fill in your own local credentials.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/securemed

# Optional local Redis URL. The synthetic demo does not require Redis.
REDIS_URL=redis://localhost:6379
